<div
  class="brand-switcher"
  style="--brand-switcher-bg: {{ section.settings.background_color }};"
>
  <div class="brand-switcher__inner">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="brand-switcher__link" aria-label="Visit partner brand">
        {{ 'cobrand-logo.svg' | inline_asset_content }}
      </a>
    {% else %}
      <span class="brand-switcher__logo">
        {{ 'cobrand-logo.svg' | inline_asset_content }}
      </span>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .brand-switcher {
    background-color: var(--brand-switcher-bg, #000000);
    height: 32px;
    display: flex;
    align-items: center;
  }

  .brand-switcher__inner {
    width: 100%;
    padding-inline: 64px;
    padding-block: 10px;
  }

  .brand-switcher__link,
  .brand-switcher__logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .brand-switcher__link {
    text-decoration: none;
  }

  .brand-switcher__link svg,
  .brand-switcher__logo svg {
    height: 16px;
    width: auto;
  }

  @media screen and (max-width: 960px) {
    .brand-switcher__inner {
      padding-inline: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.brand_switcher",
  "tag": "div",
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "Logo link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "t:names.brand_switcher"
    }
  ]
}
{% endschema %}
