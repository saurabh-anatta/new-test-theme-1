{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "brand_switcher": {
      "type": "brand-switcher",
      "settings": {}
    },
    "announcement_bar": {
      "type": "header-announcements",
      "settings": {
        "color_scheme": "scheme-7",
        "section_width": "full-width",
        "padding-block-start": 8,
        "padding-block-end": 8,
        "divider_width": 0
      },
      "blocks": {
        "announcement_1": {
          "type": "_announcement",
          "settings": {
            "text": "Black Friday Sale: Get up to 50% off <b>Shop now</b>",
            "font": "var(--font-body--family)",
            "font_size": "0.875rem"
          }
        }
      },
      "block_order": ["announcement_1"]
    },
    "header": {
      "type": "header",
      "settings": {
        "logo_position": "left",
        "menu_position": "right",
        "menu_row": "top",
        "show_search": false,
        "show_country": false,
        "show_language": false,
        "section_width": "full-width",
        "section_height": "standard",
        "enable_sticky_header": "always",
        "divider_width": 0,
        "border_width": 0,
        "actions_display_style": "icon",
        "color_scheme_top": "scheme-5"
      },
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {}
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu"
          }
        }
      }
    }
  },
  "order": [
    "brand_switcher",
    "announcement_bar",
    "header"
  ]
