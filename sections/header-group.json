{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "brand_switcher": {
      "type": "brand-switcher",
      "settings": {}
    },
    "announcement_bar": {
      "type": "header-announcements",
      "settings": {
        "color_scheme": "scheme-7",
        "section_width": "full-width",
        "padding-block-start": 8,
        "padding-block-end": 8,
        "divider_width": 0
      },
      "blocks": {
        "announcement_1": {
          "type": "_announcement",
          "settings": {
            "text": "Black Friday Sale: Get up to 50% off <b>Shop now</b>",
            "font": "var(--font-body--family)",
            "font_size": "0.875rem"
          }
        }
      },
      "block_order": ["announcement_1"]
    },
    "header": {
      "type": "header",
      "settings": {
        "logo_position": "left",
        "menu_position": "right",
        "menu_row": "top",
        "show_search": false,
        "show_country": false,
        "show_language": false,
        "section_width": "full-width",
        "section_height": "standard",
        "enable_sticky_header": "always",
        "divider_width": 0,
        "border_width": 0,
        "actions_display_style": "icon",
        "color_scheme_top": "scheme-5"
      },
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {}
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu"
          }
        }
      }
    },
    "header_cta": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.shopify-section:has(.header-cta) {\n  position: sticky;\n  top: -1px;\n  height: var(--header-height, 80px);\n  margin-top: calc(-1 * var(--header-height, 80px));\n  z-index: calc(var(--layer-sticky, 8) + 1);\n  pointer-events: none;\n}\n.shopify-section:has(.header-cta) .section-background {\n  display: none;\n}\n.shopify-section:has(.header-cta) .section {\n  background: transparent;\n  display: block;\n  height: 100%;\n  padding: 0;\n  margin: 0;\n  min-height: 0;\n}\n.header-cta {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  padding-right: clamp(120px, 10vw, 180px);\n  pointer-events: none;\n}\n.header-cta__link {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 8px 24px;\n  background-color: #6554E8;\n  color: #FFFFFF;\n  border: 1px solid #F1EFFF;\n  border-radius: 999px;\n  font-family: var(--font-heading--family, inherit);\n  font-size: 16px;\n  font-weight: 700;\n  line-height: 24px;\n  text-decoration: none;\n  box-shadow: 0 0 15px 3px rgba(255, 255, 255, 0.35), 0 4px 4px rgba(0, 0, 0, 0.1);\n  pointer-events: auto;\n  white-space: nowrap;\n}\n.header-cta__link:hover {\n  opacity: 0.9;\n}\n@media (max-width: 960px) {\n  .shopify-section:has(.header-cta) {\n    height: 0;\n    margin-top: 0;\n  }\n  .header-cta {\n    display: none;\n  }\n}\n</style>\n<div class=\"header-cta\"><a href=\"/pages/quiz\" class=\"header-cta__link\">Find your treatment</a></div>",
        "color_scheme": "scheme-5",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
  "order": [
    "brand_switcher",
    "announcement_bar",
    "header",
    "header_cta"
  ]
}
