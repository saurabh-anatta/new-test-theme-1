<div
  class="curology-how-it-works"
  style="
    --hiw-bg: {{ section.settings.background_color }};
    --hiw-padding-top: {{ section.settings.padding-block-start }}px;
    --hiw-padding-bottom: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="curology-how-it-works__container">
    <div class="curology-how-it-works__header">
      {% if section.settings.title != blank %}
        <p class="curology-how-it-works__title">{{ section.settings.title | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="curology-how-it-works__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    <div class="curology-how-it-works__steps">
      {% for block in section.blocks %}
        {% if block.type == 'step-card' %}
          <div class="curology-how-it-works__step{% if forloop.last %} curology-how-it-works__step--last{% endif %}" {{ block.shopify_attributes }}>
            <div class="curology-how-it-works__icon">
              {% case block.settings.icon %}
                {% when 'face' %}
                  {{ 'face.svg' | inline_asset_content }}
                {% when 'message' %}
                  {{ 'message.svg' | inline_asset_content }}
                {% when 'c-m' %}
                  {{ 'c-m.svg' | inline_asset_content }}
                {% when 'formula-change' %}
                  {{ 'formula-change.svg' | inline_asset_content }}
              {% endcase %}
            </div>
            <div class="curology-how-it-works__step-text">
              {% if block.settings.title != blank %}
                <h3 class="curology-how-it-works__step-title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="curology-how-it-works__step-description">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <a
        class="curology-how-it-works__button"
        {% if section.settings.button_url != blank %}href="{{ section.settings.button_url }}"{% endif %}
      >
        <span class="curology-how-it-works__button-text">{{ section.settings.button_text | escape }}</span>
        <span class="curology-how-it-works__button-arrow">{{ 'icon-arrow-right.svg' | inline_asset_content }}</span>
      </a>
    {% endif %}

    {% if section.settings.disclaimer != blank %}
      <p class="curology-how-it-works__disclaimer">{{ section.settings.disclaimer | escape }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .curology-how-it-works {
    background-color: var(--hiw-bg, #BDB4FF);
    padding-block-start: var(--hiw-padding-top, 64px);
    padding-block-end: var(--hiw-padding-bottom, 64px);
  }

  .curology-how-it-works__container {
    max-width: 1408px;
    margin: 0 auto;
    padding: 0 64px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .curology-how-it-works__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .curology-how-it-works__title {
    font-family: var(--font-accent--family), monospace;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #1D1D44;
    margin: 0;
    letter-spacing: 0;
  }

  .curology-how-it-works__heading {
    font-family: var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 40px;
    line-height: 48px;
    color: #1D1D44;
    margin: 0;
    letter-spacing: 0;
  }

  .curology-how-it-works__steps {
    display: flex;
    flex-direction: row;
    gap: 32px;
  }

  .curology-how-it-works__step {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
  }

  .curology-how-it-works__step:not(.curology-how-it-works__step--last)::after {
    content: '';
    position: absolute;
    top: 32px;
    left: 64px;
    right: -32px;
    height: 1px;
    background-color: #1D1D44;
  }

  .curology-how-it-works__icon {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .curology-how-it-works__icon svg {
    width: 64px;
    height: 64px;
    display: block;
  }

  .curology-how-it-works__step-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .curology-how-it-works__step-title {
    font-family: var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 18px;
    line-height: 24px;
    color: #1D1D44;
    margin: 0;
    letter-spacing: 0;
  }

  .curology-how-it-works__step-description {
    font-family: var(--font-body--family), sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #1D1D44;
    margin: 0;
    letter-spacing: 0;
  }

  .curology-how-it-works__button {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: #1D1D44;
    color: #FFFFFF;
    border-radius: 56px;
    padding: 16px 24px;
    text-decoration: none;
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.1);
    align-self: flex-start;
    cursor: pointer;
    border: none;
    transition: opacity 0.2s ease;
  }

  .curology-how-it-works__button:hover {
    opacity: 0.85;
  }

  .curology-how-it-works__button-text {
    font-family: var(--font-body--family), sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    color: #FFFFFF;
  }

  .curology-how-it-works__button-arrow {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 16px;
    height: 16px;
  }

  .curology-how-it-works__button-arrow svg {
    width: 16px;
    height: 16px;
    display: block;
    fill: #FFFFFF;
  }

  .curology-how-it-works__button-arrow svg path,
  .curology-how-it-works__button-arrow svg vector {
    fill: #FFFFFF;
  }

  .curology-how-it-works__disclaimer {
    font-family: var(--font-body--family), sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 14px;
    color: #1D1D44;
    margin: 0;
    letter-spacing: 0;
  }

  @media screen and (max-width: 960px) {
    .curology-how-it-works__container {
      padding: 0 24px;
    }

    .curology-how-it-works__heading {
      font-size: 28px;
      line-height: 36px;
    }

    .curology-how-it-works__steps {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .curology-how-it-works__step:not(.curology-how-it-works__step--last)::after {
      display: none;
    }

    .curology-how-it-works__button {
      align-self: stretch;
      text-align: center;
    }
  }

  @media screen and (max-width: 480px) {
    .curology-how-it-works__steps {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .curology-how-it-works *,
    .curology-how-it-works *::before,
    .curology-how-it-works *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.curology_how_it_works",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#BDB4FF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better skin in just four simple steps"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get started"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Subject to consultation. Cancel anytime."
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "step-card",
      "name": "Step Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "face", "label": "Face" },
            { "value": "message", "label": "Message" },
            { "value": "c-m", "label": "C&M" },
            { "value": "formula-change", "label": "Formula Change" }
          ],
          "default": "face"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Step description"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:names.curology_how_it_works"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
