<div
  class="curology-announcement"
  style="
    --announcement-bg: {{ section.settings.background_color }};
    --announcement-text: {{ section.settings.text_color }};
  "
>
  <div class="curology-announcement__inner">
    <div class="curology-announcement__content">
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}" class="curology-announcement__link">
      {% endif %}

      {% if section.settings.text != blank %}
        <span class="curology-announcement__text">{{ section.settings.text }}</span>
      {% endif %}

      {% if section.settings.cta_text != blank %}
        <span class="curology-announcement__cta">{{ section.settings.cta_text }}</span>
      {% endif %}

      {% if section.settings.link != blank %}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .curology-announcement {
    background-color: var(--announcement-bg, #6554E8);
    color: var(--announcement-text, #FFFFFF);
    height: 34px;
    display: flex;
    align-items: flex-end;
  }

  .curology-announcement__inner {
    width: 100%;
    padding-inline: 4px;
  }

  .curology-announcement__content {
    display: flex;
    gap: 8px;
    justify-content: center;
    align-items: center;
    padding: 8px;
    height: 34px;
  }

  .curology-announcement__link {
    display: flex;
    gap: 8px;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .curology-announcement__text {
    font-size: 14px;
    line-height: 18px;
    font-weight: 400;
  }

  .curology-announcement__cta {
    font-size: 14px;
    line-height: 18px;
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.curology_announcement",
  "tag": "div",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Black Friday Sale: Get up to 50% off"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#6554E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "t:names.curology_announcement"
    }
  ]
}
{% endschema %}
