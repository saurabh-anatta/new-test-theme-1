<curology-content-carousel
  class="curology-content-carousel"
  style="
    --carousel-bg: {{ section.settings.background_color }};
    --carousel-padding-top: {{ section.settings.padding-block-start }}px;
    --carousel-padding-bottom: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="curology-content-carousel__heading-area">
    {% if section.settings.subtitle != blank %}
      <p class="curology-content-carousel__subtitle">{{ section.settings.subtitle | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="curology-content-carousel__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="curology-content-carousel__description">{{ section.settings.description | escape }}</p>
    {% endif %}
  </div>

  <div class="curology-content-carousel__carousel">
    <div class="curology-content-carousel__track">
      {% for block in section.blocks %}
        {% if block.type == 'content-card' %}
          <div class="curology-content-carousel__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img
                class="curology-content-carousel__card-image"
                src="{{ block.settings.image | image_url: width: 656 }}"
                alt="{{ block.settings.name | escape }}"
                loading="lazy"
                width="328"
                height="328"
              >
            {% endif %}
            <div class="curology-content-carousel__card-body">
              {% if block.settings.name != blank %}
                <h3 class="curology-content-carousel__card-name">{{ block.settings.name | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="curology-content-carousel__card-description">{{ block.settings.description | escape }}</p>
              {% endif %}
              {% if block.settings.credential != blank or block.settings.location != blank %}
                <div class="curology-content-carousel__card-credential-row">
                  {% if block.settings.credential != blank %}
                    <span class="curology-content-carousel__card-credential">{{ block.settings.credential | escape }}</span>
                  {% endif %}
                  {% if block.settings.credential != blank and block.settings.location != blank %}
                    <span class="curology-content-carousel__card-dot" aria-hidden="true"></span>
                  {% endif %}
                  {% if block.settings.location != blank %}
                    <span class="curology-content-carousel__card-location">{{ block.settings.location | escape }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="curology-content-carousel__arrows-wrapper">
      <div class="curology-content-carousel__arrows">
        <button
          type="button"
          class="curology-content-carousel__arrow"
          data-carousel-prev
          aria-label="Previous slide"
          style="opacity: 0.6;"
        >
          {{ 'arrow-left.svg' | inline_asset_content }}
        </button>
        <button
          type="button"
          class="curology-content-carousel__arrow"
          data-carousel-next
          aria-label="Next slide"
        >
          {{ 'arrow-right.svg' | inline_asset_content }}
        </button>
      </div>
    </div>
  </div>
</curology-content-carousel>

<script src="{{ 'curology-content-carousel.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .curology-content-carousel {
    display: flex;
    flex-direction: column;
    gap: 32px;
    justify-content: center;
    align-items: center;
    background-color: var(--carousel-bg, #BDB4FF);
    padding: var(--carousel-padding-top, 64px) 64px var(--carousel-padding-bottom, 64px) 64px;
    overflow: hidden;
  }

  .curology-content-carousel__heading-area {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
    width: 100%;
    max-width: 1408px;
  }

  .curology-content-carousel__subtitle {
    font-family: var(--font-subheading--family), sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #1D1D44;
    margin: 0;
    letter-spacing: 0;
  }

  .curology-content-carousel__heading {
    font-family: var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 40px;
    line-height: 48px;
    color: #1D1D44;
    margin: 0;
    letter-spacing: 0;
  }

  .curology-content-carousel__description {
    font-family: var(--font-body--family), sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #1D1D44;
    margin: 0;
    letter-spacing: 0;
    max-width: 684px;
  }

  .curology-content-carousel__carousel {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
    max-width: 1408px;
  }

  .curology-content-carousel__track {
    display: flex;
    flex-direction: row;
    gap: 32px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-inline-end: 32px;
    -webkit-overflow-scrolling: touch;
  }

  .curology-content-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .curology-content-carousel__card {
    flex-shrink: 0;
    width: 328px;
    display: flex;
    flex-direction: column;
  }

  .curology-content-carousel__card-image {
    width: 328px;
    height: 328px;
    object-fit: cover;
    border-radius: 8px 8px 0 0;
    display: block;
  }

  .curology-content-carousel__card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background-color: #FFFFFF;
    border-radius: 0 0 8px 8px;
  }

  .curology-content-carousel__card-name {
    font-family: var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #1D1D44;
    margin: 0;
    letter-spacing: 0;
  }

  .curology-content-carousel__card-description {
    font-family: var(--font-body--family), sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #1D1D44;
    margin: 0;
    letter-spacing: 0;
  }

  .curology-content-carousel__card-credential-row {
    display: flex;
    flex-direction: row;
    gap: 8px;
    align-items: center;
  }

  .curology-content-carousel__card-credential {
    font-family: var(--font-body--family), sans-serif;
    font-weight: 700;
    font-size: 12px;
    line-height: 14px;
    color: #1D1D44;
    letter-spacing: 0;
  }

  .curology-content-carousel__card-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #1D1D44;
    flex-shrink: 0;
  }

  .curology-content-carousel__card-location {
    font-family: var(--font-body--family), sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 14px;
    color: #1D1D44;
    letter-spacing: 0;
  }

  .curology-content-carousel__arrows-wrapper {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
  }

  .curology-content-carousel__arrows {
    display: flex;
    flex-direction: row;
    gap: 16px;
    align-items: center;
  }

  .curology-content-carousel__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    padding: 8px;
    background-color: #FFFFFF;
    border: 1px solid #1D1D44;
    cursor: pointer;
    transform: rotate(3.1deg);
  }

  .curology-content-carousel__arrow svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  .curology-content-carousel__arrow:focus-visible {
    outline: 2px solid #1D1D44;
    outline-offset: 2px;
  }

  /* Mobile */
  @media screen and (max-width: 960px) {
    .curology-content-carousel {
      padding: 32px 24px;
      gap: 24px;
    }

    .curology-content-carousel__heading {
      font-size: 28px;
      line-height: 36px;
    }

    .curology-content-carousel__track {
      gap: 16px;
      scroll-snap-type: x mandatory;
      padding-inline-end: 16px;
    }

    .curology-content-carousel__card {
      width: 260px;
      scroll-snap-align: start;
    }

    .curology-content-carousel__card-image {
      width: 260px;
      height: 260px;
    }

    .curology-content-carousel__arrows {
      display: none;
    }

    .curology-content-carousel__carousel {
      gap: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .curology-content-carousel__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.curology_content_carousel",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#BDB4FF"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Meet our providers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dermatologist founded, tested & developed"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "We're powered by 100+ in-house licensed dermatology providers. Our derms have 1,700 interactions every day with our customers."
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "content-card",
      "name": "Content Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Dr Jhamilia Weekers-Bowers"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Licensed family nurse practitioner based out of San Diego, CA, focusing on cardiology, urology, and cosmetic dermatology."
        },
        {
          "type": "text",
          "id": "credential",
          "label": "Credential",
          "default": "NP-C"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "California"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "t:names.curology_content_carousel"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
