{% liquid
  assign menu = section.settings.menu
  assign cta_text = section.settings.cta_text
  assign cta_link = section.settings.cta_link
  assign show_user_icon = section.settings.show_user_icon
  assign enable_sticky = section.settings.enable_sticky
%}

<curology-header-component
  class="curology-header"
  data-enable-sticky="{{ enable_sticky }}"
  style="
    --curology-header-bg: {{ section.settings.background_color }};
    --curology-header-text: {{ section.settings.text_color }};
    --curology-header-cta: {{ section.settings.cta_color }};
  "
>
  <header class="curology-header__bar">
    <div class="curology-header__inner">
      {%- comment -%} Logo {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="curology-header__logo" aria-label="{{ shop.name }}">
        {{ 'logo-curology-dark.svg' | inline_asset_content }}
      </a>

      {%- comment -%} Desktop Navigation {%- endcomment -%}
      <div class="curology-header__right">
        {% if menu != blank %}
          <nav class="curology-header__nav" aria-label="Main navigation">
            <ul class="curology-header__nav-list">
              {% for link in linklists[menu].links %}
                <li class="curology-header__nav-item">
                  {% if link.links.size > 0 %}
                    <button
                      type="button"
                      class="curology-header__nav-link curology-header__nav-link--has-children"
                      aria-expanded="false"
                      aria-controls="header-dropdown-{{ forloop.index }}"
                      on:click="/handleDropdownToggle"
                    >
                      <span>{{ link.title | escape }}</span>
                      <span class="curology-header__caret">
                        {{ 'caret-down.svg' | inline_asset_content }}
                      </span>
                    </button>

                    <div
                      id="header-dropdown-{{ forloop.index }}"
                      class="curology-header__dropdown"
                      aria-hidden="true"
                    >
                      <ul class="curology-header__dropdown-list">
                        {% for child_link in link.links %}
                          <li>
                            <a href="{{ child_link.url }}" class="curology-header__dropdown-link">
                              {{ child_link.title | escape }}
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% else %}
                    <a href="{{ link.url }}" class="curology-header__nav-link">
                      <span>{{ link.title | escape }}</span>
                    </a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}

        {%- comment -%} CTA Button {%- endcomment -%}
        {% if cta_text != blank %}
          <div class="curology-header__cta-wrapper">
            <a
              href="{{ cta_link | default: routes.root_url }}"
              class="curology-header__cta-button"
            >
              <span>{{ cta_text | escape }}</span>
            </a>
          </div>
        {% endif %}

        {%- comment -%} Icons {%- endcomment -%}
        <div class="curology-header__icons">
          {% if show_user_icon %}
            <a href="{{ routes.account_url }}" class="curology-header__icon curology-header__icon--user" aria-label="Account">
              {{ 'user.svg' | inline_asset_content }}
            </a>
          {% endif %}

          <a href="{{ routes.cart_url }}" class="curology-header__icon curology-header__icon--cart" aria-label="Cart">
            <span class="curology-header__cart-icon">
              {{ 'bag.svg' | inline_asset_content }}
            </span>
            <span class="curology-header__cart-badge">
              <span ref="cartBadge">{{ cart.item_count }}</span>
            </span>
          </a>
        </div>
      </div>

      {%- comment -%} Mobile Icons {%- endcomment -%}
      <div class="curology-header__mobile-icons">
        <a href="{{ routes.cart_url }}" class="curology-header__icon curology-header__icon--cart" aria-label="Cart">
          <span class="curology-header__cart-icon">
            {{ 'bag.svg' | inline_asset_content }}
          </span>
          <span class="curology-header__cart-badge">
            <span ref="cartBadge">{{ cart.item_count }}</span>
          </span>
        </a>

        <button
          type="button"
          class="curology-header__hamburger"
          ref="drawerOpen"
          on:click="/handleDrawerOpen"
          aria-label="Open navigation menu"
          aria-haspopup="dialog"
        >
          <svg width="16" height="14" viewBox="0 0 16 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <line x1="0" y1="1" x2="16" y2="1" stroke="currentColor" stroke-width="2"/>
            <line x1="0" y1="7" x2="16" y2="7" stroke="currentColor" stroke-width="2"/>
            <line x1="0" y1="13" x2="16" y2="13" stroke="currentColor" stroke-width="2"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  {%- comment -%} Mobile Drawer {%- endcomment -%}
  <dialog ref="mobileDrawer" class="curology-header__drawer" aria-label="Navigation menu">
    <div class="curology-header__drawer-inner">
      <div class="curology-header__drawer-header">
        <a href="{{ routes.root_url }}" class="curology-header__logo" aria-label="{{ shop.name }}">
          {{ 'logo-curology-dark.svg' | inline_asset_content }}
        </a>
        <button
          type="button"
          class="curology-header__drawer-close"
          ref="drawerClose"
          on:click="/handleDrawerClose"
          aria-label="Close navigation menu"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <line x1="2" y1="2" x2="18" y2="18" stroke="currentColor" stroke-width="2"/>
            <line x1="18" y1="2" x2="2" y2="18" stroke="currentColor" stroke-width="2"/>
          </svg>
        </button>
      </div>

      {% if menu != blank %}
        <nav class="curology-header__drawer-nav" aria-label="Mobile navigation">
          <ul class="curology-header__drawer-list">
            {% for link in linklists[menu].links %}
              <li class="curology-header__drawer-item">
                {% if link.links.size > 0 %}
                  <button
                    type="button"
                    class="curology-header__drawer-link curology-header__drawer-link--parent"
                    aria-expanded="false"
                    aria-controls="mobile-dropdown-{{ forloop.index }}"
                    on:click="/handleMobileToggle"
                  >
                    <span>{{ link.title | escape }}</span>
                    <span class="curology-header__caret">
                      {{ 'caret-down.svg' | inline_asset_content }}
                    </span>
                  </button>
                  <ul id="mobile-dropdown-{{ forloop.index }}" class="curology-header__drawer-sublist" hidden>
                    {% for child_link in link.links %}
                      <li>
                        <a href="{{ child_link.url }}" class="curology-header__drawer-sublink">
                          {{ child_link.title | escape }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% else %}
                  <a href="{{ link.url }}" class="curology-header__drawer-link">
                    <span>{{ link.title | escape }}</span>
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

      {% if cta_text != blank %}
        <div class="curology-header__drawer-cta">
          <a
            href="{{ cta_link | default: routes.root_url }}"
            class="curology-header__cta-button"
          >
            <span>{{ cta_text | escape }}</span>
          </a>
        </div>
      {% endif %}
    </div>
  </dialog>

  <script src="{{ 'curology-header.js' | asset_url }}" type="module"></script>
</curology-header-component>

{% stylesheet %}
  curology-header-component {
    display: block;
    position: relative;
    z-index: 100;
  }

  curology-header-component.curology-header--sticky {
    position: sticky;
    top: 0;
  }

  .curology-header__bar {
    background-color: var(--curology-header-bg, #1D1D44);
    color: var(--curology-header-text, #FFFFFF);
  }

  .curology-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 32px 64px;
    height: 80px;
  }

  .curology-header__logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    flex-shrink: 0;
    text-decoration: none;
  }

  .curology-header__logo svg {
    height: 34px;
    width: auto;
  }

  /* Desktop right section */
  .curology-header__right {
    display: flex;
    align-items: center;
    gap: 32px;
    justify-content: flex-end;
  }

  /* Navigation */
  .curology-header__nav-list {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .curology-header__nav-item {
    position: relative;
  }

  .curology-header__nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 24px;
    font-size: 16px;
    line-height: 20px;
    font-weight: 700;
    color: var(--curology-header-text, #FFFFFF);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .curology-header__nav-link:hover {
    text-decoration: underline;
  }

  .curology-header__caret {
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .curology-header__caret svg {
    width: 16px;
    height: 16px;
  }

  .curology-header__nav-link--has-children[aria-expanded="true"] .curology-header__caret {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .curology-header__dropdown {
    position: absolute;
    top: 100%;
    inset-inline-start: 0;
    min-width: 220px;
    background-color: var(--curology-header-bg, #1D1D44);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 12px 0;
    z-index: 200;
    opacity: 1;
    transition: opacity 0.2s ease;
  }

  .curology-header__dropdown[aria-hidden="true"] {
    display: none;
    opacity: 0;
  }

  .curology-header__dropdown-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .curology-header__dropdown-link {
    display: block;
    padding: 8px 24px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
    color: var(--curology-header-text, #FFFFFF);
    text-decoration: none;
    white-space: nowrap;
  }

  .curology-header__dropdown-link:hover {
    text-decoration: underline;
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* CTA Button */
  .curology-header__cta-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .curology-header__cta-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: #F1EFFF;
    border-radius: 24px;
    filter: blur(24px);
    z-index: 0;
  }

  .curology-header__cta-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    min-height: 40px;
    background-color: var(--curology-header-cta, #6554E8);
    color: #FFFFFF;
    border: 1px solid #F1EFFF;
    border-radius: 56px;
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.1);
    z-index: 1;
  }

  .curology-header__cta-button:hover {
    opacity: 0.9;
  }

  .curology-header__cta-button:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }

  /* Icons */
  .curology-header__icons {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .curology-header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--curology-header-text, #FFFFFF);
    text-decoration: none;
    position: relative;
  }

  .curology-header__icon svg {
    width: 16px;
    height: 16px;
  }

  .curology-header__icon--cart {
    position: relative;
  }

  .curology-header__cart-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  .curology-header__cart-icon svg {
    width: 16px;
    height: 16px;
  }

  .curology-header__cart-badge {
    position: absolute;
    top: -4px;
    inset-inline-end: -8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--curology-header-cta, #6554E8);
    box-shadow: 0 0 8px #FFFFFF;
    font-size: 12px;
    line-height: 18px;
    font-weight: 700;
    color: #FFFFFF;
    text-align: center;
  }

  /* Mobile icons */
  .curology-header__mobile-icons {
    display: none;
    align-items: center;
    gap: 12px;
  }

  .curology-header__hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--curology-header-text, #FFFFFF);
    cursor: pointer;
    padding: 4px;
    min-width: 24px;
    min-height: 24px;
  }

  .curology-header__hamburger:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }

  /* Mobile Drawer */
  .curology-header__drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background-color: var(--curology-header-bg, #1D1D44);
    color: var(--curology-header-text, #FFFFFF);
    z-index: 1000;
    overflow-y: auto;
  }

  .curology-header__drawer[open] {
    display: flex;
    flex-direction: column;
  }

  .curology-header__drawer::backdrop {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .curology-header__drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 16px;
    min-height: 100%;
  }

  .curology-header__drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 10px;
  }

  .curology-header__drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--curology-header-text, #FFFFFF);
    cursor: pointer;
    padding: 4px;
    min-width: 24px;
    min-height: 24px;
  }

  .curology-header__drawer-close:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }

  .curology-header__drawer-nav {
    flex: 1;
  }

  .curology-header__drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .curology-header__drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 12px 8px;
    font-size: 16px;
    line-height: 20px;
    font-weight: 700;
    color: var(--curology-header-text, #FFFFFF);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    text-align: start;
  }

  .curology-header__drawer-link--parent[aria-expanded="true"] .curology-header__caret {
    transform: rotate(180deg);
  }

  .curology-header__drawer-sublist {
    list-style: none;
    margin: 0;
    padding: 0 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .curology-header__drawer-sublink {
    display: block;
    padding: 8px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
    color: var(--curology-header-text, #FFFFFF);
    text-decoration: none;
  }

  .curology-header__drawer-sublink:hover {
    text-decoration: underline;
  }

  .curology-header__drawer-cta {
    padding: 8px;
  }

  .curology-header__drawer-cta .curology-header__cta-button {
    width: 100%;
    text-align: center;
  }

  /* Responsive */
  @media screen and (max-width: 960px) {
    .curology-header__inner {
      padding: 10px 16px;
      height: 64px;
    }

    .curology-header__right {
      display: none;
    }

    .curology-header__mobile-icons {
      display: flex;
    }
  }

  @media screen and (min-width: 961px) {
    .curology-header__drawer {
      display: none;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .curology-header__caret,
    .curology-header__dropdown {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.curology_header",
  "tag": "div",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Find your treatment"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "checkbox",
      "id": "show_user_icon",
      "label": "Show user icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1D1D44"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "CTA color",
      "default": "#6554E8"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "t:names.curology_header"
    }
  ]
}
{% endschema %}
